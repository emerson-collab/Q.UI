        "gate_pass": "#3fb950",
        "gate_fail": "#f85149",
        "gate_environment_failure": "#d29922"
      }
    },
    "typography": {
      "ui_font_stack": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "mono_font_stack": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "base_font_size": 14,
      "small_font_size": 12,
      "body_line_height": 1.5,
      "heading_weight": 600,
      "body_weight": 400,
      "control_weight": 500
