{"capability_contract_ref":"Q.UI.CONTRACT.CAPABILITY.UI_THEME@V0109","capability_rules":{"authority_kind":"CONTRACT","rule_count":34,"rule_set_id":"q.ui.ui_theme.contract_invariants","rule_set_version":"V0109","rules":[{"assertion":"UI_THEME is one Capability under Q.UI.","rule_id":"UI_THEME.R001","rule_version":"V0109","sequence":1,"status":"active"},{"assertion":"resolve_ui_theme is the sole Operation inside UI_THEME.","rule_id":"UI_THEME.R002","rule_version":"V0109","sequence":2,"status":"active"},{"assertion":"ui_theme_invoke is the sole Specification Interface and binds only to resolve_ui_theme.","rule_id":"UI_THEME.R003","rule_version":"V0109","sequence":3,"status":"active"},{"assertion":"theme_selector is mandatory and MUST conform to ui_theme_selector; unknown selector keys are forbidden.","rule_id":"UI_THEME.R004","rule_version":"V0109","sequence":4,"status":"active"},{"assertion":"UI_THEME uses SELF_CONTAINED_SELECTOR resolution and MUST NOT perform external or local Theme lookup.","rule_id":"UI_THEME.R005","rule_version":"V0109","sequence":5,"status":"active"},{"assertion":"ui_theme_selector MUST contain exactly one theme_material and MAY contain context_constraints.","rule_id":"UI_THEME.R006","rule_version":"V0109","sequence":6,"status":"active"},{"assertion":"theme_material theme_ref and theme_version MUST form one coherent exact version tuple using the final @ suffix.","rule_id":"UI_THEME.R007","rule_version":"V0109","sequence":7,"status":"active"},{"assertion":"theme_material content_hash MUST equal SHA-256 over RFC8785 canonical UTF-8 JSON of exactly theme_ref theme_version and presentation_rules.","rule_id":"UI_THEME.R008","rule_version":"V0109","sequence":8,"status":"active"},{"assertion":"presentation_rules MUST be projected exactly from theme_material without merge default synthesis repair or reinterpretation.","rule_id":"UI_THEME.R009","rule_version":"V0109","sequence":9,"status":"active"},{"assertion":"Absent or empty context_constraints are compatible; nonempty constraints require ui_context and compare each top-level constrained value by RFC8785 canonical equality.","rule_id":"UI_THEME.R010","rule_version":"V0109","sequence":10,"status":"active"},{"assertion":"Extra ui_context keys are allowed but MUST NOT modify Theme resolution or Theme material.","rule_id":"UI_THEME.R011","rule_version":"V0109","sequence":11,"status":"active"},{"assertion":"ui_module_artifact_ref is an optional opaque nonselecting correlation input and MUST NOT alter selection compatibility Theme material or business response.","rule_id":"UI_THEME.R012","rule_version":"V0109","sequence":12,"status":"active"},{"assertion":"UI_THEME MUST NOT become business-semantic authority.","rule_id":"UI_THEME.R013","rule_version":"V0109","sequence":13,"status":"active"},{"assertion":"UI_THEME MUST NOT infer missing business semantics or derive Theme fields from undeclared sources.","rule_id":"UI_THEME.R014","rule_version":"V0109","sequence":14,"status":"active"},{"assertion":"UI_THEME MUST NOT redefine business Operations.","rule_id":"UI_THEME.R015","rule_version":"V0109","sequence":15,"status":"active"},{"assertion":"UI_THEME MUST NOT alter UI Module Artifact Operation bindings.","rule_id":"UI_THEME.R016","rule_version":"V0109","sequence":16,"status":"active"},{"assertion":"UI_THEME MUST NOT alter upstream validation semantics.","rule_id":"UI_THEME.R017","rule_version":"V0109","sequence":17,"status":"active"},{"assertion":"Successful output MUST be exactly one governed ui_theme_artifact.","rule_id":"UI_THEME.R018","rule_version":"V0109","sequence":18,"status":"active"},{"assertion":"ui_theme_artifact MUST remain one logical governed handoff unit.","rule_id":"UI_THEME.R019","rule_version":"V0109","sequence":19,"status":"active"},{"assertion":"Successful output MUST include resolver_capability_ref and resolver_operation_ref bound to this exact UI_THEME successor.","rule_id":"UI_THEME.R020","rule_version":"V0109","sequence":20,"status":"active"},{"assertion":"UI_THEME_SELECTOR_UNRESOLVED triggers only after request schema conformance when Theme identity tuple or Theme content hash validation fails.","rule_id":"UI_THEME.R021","rule_version":"V0109","sequence":21,"status":"active"},{"assertion":"UI_THEME_CONTEXT_INCOMPATIBLE triggers only after selector resolution when declared context constraints fail the exact compatibility predicate.","rule_id":"UI_THEME.R022","rule_version":"V0109","sequence":22,"status":"active"},{"assertion":"Payload schema violations MUST remain payload/runtime-boundary failures and MUST NOT be remapped to a UI_THEME StableError.","rule_id":"UI_THEME.R023","rule_version":"V0109","sequence":23,"status":"active"},{"assertion":"The two UI_THEME StableError conditions are ordered and mutually exclusive; selector failure precedes context evaluation.","rule_id":"UI_THEME.R024","rule_version":"V0109","sequence":24,"status":"active"},{"assertion":"Business-semantic inference attempts are implementation conformance failures, not a third UI_THEME runtime StableError.","rule_id":"UI_THEME.R025","rule_version":"V0109","sequence":25,"status":"active"},{"assertion":"UI_THEME MUST NOT silently default to an ungoverned Theme.","rule_id":"UI_THEME.R026","rule_version":"V0109","sequence":26,"status":"active"},{"assertion":"UI_THEME MUST NOT select a UI_PRODUCER Operation.","rule_id":"UI_THEME.R027","rule_version":"V0109","sequence":27,"status":"active"},{"assertion":"UI_THEME MUST NOT generate a Host Artifact.","rule_id":"UI_THEME.R028","rule_version":"V0109","sequence":28,"status":"active"},{"assertion":"UI_THEME MUST NOT perform UI_HOST runtime responsibility.","rule_id":"UI_THEME.R029","rule_version":"V0109","sequence":29,"status":"active"},{"assertion":"Theme-only changes MUST NOT require business Capability modification.","rule_id":"UI_THEME.R030","rule_version":"V0109","sequence":30,"status":"active"},{"assertion":"UI_THEME has no local or external business dependency; dependency mount fields and dependency_request are forbidden on ui_theme_invoke.","rule_id":"UI_THEME.R031","rule_version":"V0109","sequence":31,"status":"active"},{"assertion":"P2 is only the downstream publication/mount realization owner for this PUBLICATION_ELIGIBLE surface and is not a P1 formal business dependency.","rule_id":"UI_THEME.R032","rule_version":"V0109","sequence":32,"status":"active"},{"assertion":"PUBLICATION_ELIGIBLE physical projection MUST include the exact five export source files and two export test files required by P1 BUSINESS_RUNTIME.","rule_id":"UI_THEME.R033","rule_version":"V0109","sequence":33,"status":"active"},{"assertion":"Exact canonical identity hash registry serialization and immutable Contract ref/hash binding follow current Q standards.","rule_id":"UI_THEME.R034","rule_version":"V0109","sequence":34,"status":"active"}]},"dependencies":{"cross_domain_dependency_realization_owned_by_p2":true,"dependency_creation_by_p2_forbidden":true,"external_dependencies":{},"external_theme_provider_dependency_forbidden":true,"implicit_dependency_forbidden":true,"local_dependencies":[],"p2_is_downstream_publication_mount_owner_not_p1_formal_dependency":true},"persistence_requirements":{"capability_contract_does_not_own_physical_database_objects":true,"cross_domain_database_ownership_created":false,"database_objects_owned_by_capability":false,"domain_contract_required":false,"fixed_physical_table_names_required_by_capability_contract":false,"owner_local_persistence_required":false,"persistence_may_not_expand_external_provider_surface":true,"physical_persistence_realization_owner":"exact repository owner-local Skeleton/runtime","retired_database_persistence_meta_contract_is_not_normative_dependency":true},"stable_errors":{"resolve_ui_theme":{"silent_fallback_forbidden":true,"stable_error_contract_ref":"Q.UI.CONTRACT.CAPABILITY.UI_THEME@V0109#/stable_error_contract"}}}
