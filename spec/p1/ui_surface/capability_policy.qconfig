capability_contract_ref: Q.UI.CONTRACT.CAPABILITY.UI_SURFACE@V0112
capability_contract_hash: sha256:5030b5215a633b9cdcec9022f7df2c0bd9c6df8d4c61d3e43b2b596a2934b806
runtime_contract_ref: Q.SS.STD.P0.CONTRACT.RUNTIME_CORE@V0134
fixed_skeleton_mutation_forbidden: true
extra_operation_file_forbidden_by_default: true
module_layer_forbidden: true
direct_handler_export_forbidden: true
invariants:
- Each UI Surface consumes exact UI Module artifacts plus exactly one presentation context.
- APPLICATION context may resolve only from Q.APP APPLICATION_PRESENTATION and PLATFORM context only from Q.Platform PLATFORM_WORKBENCH.
- Q.APP and Q.Platform are alternative presentation-context providers; dual injection into one Surface is forbidden.
- UI Surface composes but does not mutate source business semantics or execute source Business Operations.
- Q.Theme visual semantics are not owned or selected by UI Surface; Theme is consumed downstream by UI Render.
- create_ui_surface produces an unresolved target-neutral artifact with resolved_target_context null.
- resolve_ui_surface may set only exact resolved_target_context and recompute content_hash; all selected context and UI Module lineage is preserved.
- Canonical composition uses one presentation-context root region and one slot per UI Module in declared order.
- Navigation projection carries exact presentation-context surface_requirements without transformation.
- Interaction bindings are copied from exact Module action bindings and bound only to their exact generated slot refs.
- Label copy or business semantic synthesis is forbidden.
external_mount_requirements:
- requirement_id: application
  source_ref: Q.UI.CONTRACT.CAPABILITY.UI_SURFACE@V0112#/dependencies/external_dependencies/presentation_context/allowed_candidates/application
  realization_owner: Q.SS.STD.P2.CONTRACT.CROSS_DOMAIN_REALIZATION@V0123
  p1_provider_implementation_forbidden: true
- requirement_id: platform
