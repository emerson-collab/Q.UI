{
  "q_header": "1",
  "stable_error_contract_ref": "Q.UI.CONTRACT.CAPABILITY.UI_MODULE@V0126#/stable_errors/resolve_ui_module",
  "stable_error_evaluation_order": [
    "UI_MODULE_SOURCE_CAPABILITY_LINEAGE_UNRESOLVED",
    "UI_MODULE_SOURCE_CAPABILITY_SEMANTIC_PROJECTION_INVALID",
