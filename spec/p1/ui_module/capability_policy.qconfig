    "UI_MODULE_OPERATION_COVERAGE_INCOMPLETE",
    "UI_MODULE_INTERFACE_COVERAGE_INCOMPLETE",
    "UI_MODULE_FIELD_COVERAGE_INCOMPLETE",
    "UI_MODULE_ACTION_LINEAGE_INCOMPLETE",
    "UI_MODULE_OPERATIONAL_RELATION_PROJECTION_INVALID",
    "UI_MODULE_STATE_MODEL_PROJECTION_INVALID",
    "UI_MODULE_PERMISSION_MODEL_PROJECTION_INVALID",
    "UI_MODULE_RULE_BINDING_PROJECTION_INVALID",
    "UI_MODULE_LOGIC_GRAPH_COVERAGE_INCOMPLETE",
    "UI_MODULE_OUTPUT_GRAMMAR_INVALID",
    "UI_MODULE_PRESENTATION_CONTEXT_INPUT_FORBIDDEN",
    "UI_MODULE_SOURCE_OPERATION_EXECUTION_FORBIDDEN"
  ],
  "stable_error_messages": {
    "UI_MODULE_SOURCE_CAPABILITY_LINEAGE_UNRESOLVED": "The exact source Capability Contract ref/hash or exact External Provider Surface ref/hash cannot be resolved and verified.",
    "UI_MODULE_SOURCE_CAPABILITY_SEMANTIC_PROJECTION_INVALID": "The exact source Capability semantic projection is incomplete, inconsistent with its exact Contract closure, or cannot be deterministically verified.",
    "UI_MODULE_PAYLOAD_SCHEMA_MAPPING_AMBIGUOUS": "One source request or response field cannot be mapped deterministically from its exact declared owner schema.",
    "UI_MODULE_OPERATION_COVERAGE_INCOMPLETE": "One or more exact source Operations is missing, duplicated, or mismatched in the UI Operation projection coverage.",
    "UI_MODULE_FIELD_COVERAGE_INCOMPLETE": "One or more exact request or response field occurrence is missing, duplicated, reordered, or not bound to its exact source schema material.",
    "UI_MODULE_ACTION_LINEAGE_INCOMPLETE": "An executable UI action does not retain the complete exact source Capability, Operation, Interface, request, response, outcome, StableError and External Provider Surface lineage.",
    "UI_MODULE_OUTPUT_GRAMMAR_INVALID": "The emitted UI Module Artifact does not conform to the closed owner-local interaction semantic grammar declared by this Contract.",
    "UI_MODULE_PRESENTATION_CONTEXT_INPUT_FORBIDDEN": "Production topology, Surface, Theme, Render or Host presentation context was supplied to UI Module and is forbidden at this boundary.",
    "UI_MODULE_SOURCE_OPERATION_EXECUTION_FORBIDDEN": "The request attempts to execute or re-own a source Business Operation during UI Module semantic projection.",
    "UI_MODULE_REFERENCE_SEMANTICS_AMBIGUOUS": "A source field declares BUSINESS_REFERENCE semantics but exact owner, resolution, identity, cardinality, manual-entry or read/lookup closure cannot be deterministically resolved from the source Capability Contract.",
    "UI_MODULE_TEMPORAL_SEMANTICS_AMBIGUOUS": "A source field declares TEMPORAL semantics but exact temporal kind, JSON Schema format or structured range endpoint semantics cannot be deterministically resolved from the source Capability Contract.",
    "UI_MODULE_FIELD_SEMANTIC_COVERAGE_INCOMPLETE": "One or more source request-field occurrences lacks exactly one valid x_q_field_semantics classification required by the current Capability Contract authority.",
    "UI_MODULE_REFERENCE_BINDING_INVALID": "A BUSINESS_REFERENCE field cannot be normalized into a closed reference binding because owner/dependency identity, read/lookup request mapping, result paths, candidate identity/display paths, or cardinality/schema compatibility is missing or inconsistent.",
    "UI_MODULE_TEMPORAL_BINDING_INVALID": "A TEMPORAL field cannot be normalized into a closed temporal binding because scalar format or RANGE endpoint paths/kind are missing or inconsistent with the exact source schema.",
    "UI_MODULE_OPERATIONAL_RELATION_PROJECTION_INVALID": "The exact source operational_relations closure cannot be projected losslessly into UI logic semantics.",
    "UI_MODULE_STATE_MODEL_PROJECTION_INVALID": "The exact source state_model closure cannot be projected with complete state-machine, subject, applicability and transition semantics.",
    "UI_MODULE_PERMISSION_MODEL_PROJECTION_INVALID": "The exact source permission_model closure cannot be projected with complete permission and actor identity semantics.",
    "UI_MODULE_RULE_BINDING_PROJECTION_INVALID": "The exact source rule_bindings closure cannot be projected with complete enforcement target and evaluation-realization semantics.",
    "UI_MODULE_LOGIC_GRAPH_COVERAGE_INCOMPLETE": "The emitted UI logic projection does not completely cover the exact source operational relation, state, permission, actor and rule-binding graph.",
    "UI_MODULE_INTERFACE_COVERAGE_INCOMPLETE": "One or more exact source Interfaces is missing, duplicated, not under its exact owner Operation, or does not retain the exact request, response, outcome and StableError Contract identities."
  },
  "rule_binding_mode": "DECLARED",
